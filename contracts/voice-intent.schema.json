{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoiceIntent",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "PAY_METRO",
        "CHECK_BALANCE",
        "CHECK_EMI",
        "PAY_BILL",
        "MEDICAL_CLAIM_HELP",
        "SAVE_SURPLUS",
        "REVIEW_COMMITMENTS",
        "LOCK_CARD",
        "GENERAL_QUERY"
      ]
    },
    "language": {
      "type": "string",
      "enum": ["en", "hi", "gu"],
      "default": "en"
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "entities": {
      "type": "object",
      "additionalProperties": true
    },
    "response_text": { "type": "string" },
    "suggested_actions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "intent",
    "language"
  ]
}
