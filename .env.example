# ============================================
# VZEYA — Environment Configuration
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env or any file containing secrets.

# --- Backend (Harsh) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
# DATABASE_URL=              # Not yet required (using JSON seed data)
# SECRET_KEY=                # Required for production auth

# --- Frontend (Lakshya) ---
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
USE_MOCK_CONTRACT=false
# Set to true to develop frontend without backend running

# --- AI Engine (Ubaid) ---
AI_VERBOSITY=info
DEFAULT_LANGUAGE=en
# MINICPM5_MODEL_PATH=       # Path to local SLM weights (not yet integrated)
# HF_TOKEN=                  # HuggingFace token for model download (if needed)
