# ============================================
# ABC Bank — Environment Configuration
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env or any file containing secrets.

# --- Backend (Harsh) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
# Database (PostgreSQL / AWS RDS / Prisma Studio)
# Python/SQLAlchemy (on server): postgresql+psycopg://abc_bank:AbcBank_Secure2026_KeyDB!@localhost:5432/abc_bank
# Prisma Studio (local via tunnel): postgresql://abc_bank:AbcBank_Secure2026_KeyDB!@localhost:5433/abc_bank
DATABASE_URL=postgresql://abc_bank:AbcBank_Secure2026_KeyDB!@localhost:5433/abc_bank

# --- Frontend (Lakshya) ---
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
USE_MOCK_CONTRACT=false
# Set to true to develop frontend without backend running

# --- AI Engine (Ubaid) ---
AI_VERBOSITY=info
DEFAULT_LANGUAGE=en
# MINICPM5_MODEL_PATH=       # Path to local SLM weights (not yet integrated)
# HF_TOKEN=                  # HuggingFace token for model download (if needed)
